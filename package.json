{
  "name": "timestamped-summary-for-youtube",
  "version": "1.4.0",
  "private": true,
  "description": "Chrome extension that adds a timestamped, sectioned AI summary to the YouTube sidebar.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyank1205/yt-transcript-ext.git"
  },
  "scripts": {
